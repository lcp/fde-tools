alias cmd_requires_luks_device=true
alias cmd_perform=cmd_add_secondary_key

function cmd_add_secondary_key {

    local luks_devices="$1"

    if [ -n "$FDE_ENROLL_NEW_KEY" ]; then
	display_errorbox "It seems you've already tried to enroll a secondary key."
	return 1
    fi

    for luks_dev in ${luks_devices}; do
	keyslots=$(bootloader_get_keyslots ${luks_dev})

	if [ -n "${keyslots}" ]; then
	    display_errorbox "It seems you've already enrolled a secondary key.(${luks_dev})"
	    return 1
	fi
    done

    if ! enroll_tpm_secondary_key "${luks_devices}"; then
	return 1
    fi

    return 0
}

##################################################################
# Authorized policy files are created in a staging directory next to
# the live ones and only moved into place once the new key is sealed.
# tpm-authorize signs the sealed key in $FDE_CONFIG_DIR with the private
# key there, and the TPM only accepts the result if both belong to the
# same policy. Replacing the private key and then failing would break
# every later tpm-authorize.
##################################################################

# Print the staging path of a live authorized policy file.
function _ap_staged {

    echo "$FDE_AP_STAGE_DIR/${1##*/}"
}

function stage_authorized_policy {

    policy_name="$FDE_AUTHORIZED_POLICY"
    if [ -z "$policy_name" ]; then
	policy_name="$FDE_DEFAULT_AUTHORIZED_POLICY"
    fi

    tpm_set_authorized_policy_paths "$policy_name"

    # Same file system as the live files, so that moving them into place
    # is a rename. A directory left by an interrupted run is replaced.
    declare -g FDE_AP_STAGE_DIR="$FDE_CONFIG_DIR/.${policy_name}.new"
    rm -rf "$FDE_AP_STAGE_DIR"
    if ! mkdir -m 700 "$FDE_AP_STAGE_DIR"; then
	display_errorbox "Failed to create $FDE_AP_STAGE_DIR"
	return 1
    fi

    # Keep the existing private key unless it is missing or we are
    # running regenerate-key (see tpm_create_authorized_policy).
    if [ -f "$FDE_AP_SECRET_KEY" ] &&
       ! cp -p "$FDE_AP_SECRET_KEY" "$(_ap_staged "$FDE_AP_SECRET_KEY")"; then
	display_errorbox "Failed to copy $FDE_AP_SECRET_KEY"
	return 1
    fi

    ##################################################################
    # Create the policy. If the private key does not exist yet,
    # pcr-oracle will generate a suitable key.
    # We also store a copy of the public key in a TPMv2 format so that
    # boot loaders do need a full PEM/ASN.1/bignum library just for
    # loading the pubkey.
    if ! tpm_create_authorized_policy "$(_ap_staged "$FDE_AP_SECRET_KEY")" \
		"$(_ap_staged "$FDE_AP_AUTHPOLICY")" \
		"$(_ap_staged "$FDE_AP_PUBLIC_KEY")"; then
	display_errorbox "Failed to create authorized policy"
	return 1
    fi
}

function commit_authorized_policy {

    local f

    for f in "$FDE_AP_SECRET_KEY" "$FDE_AP_AUTHPOLICY" \
	     "$FDE_AP_PUBLIC_KEY" "$FDE_AP_SEALED_SECRET"; do
	if ! mv -f "$(_ap_staged "$f")" "$f"; then
	    display_errorbox "Failed to install $f"
	    return 1
	fi
    done
    rmdir "$FDE_AP_STAGE_DIR"

    if [ "$FDE_AUTHORIZED_POLICY" != "$policy_name" ]; then
	fde_set_variable FDE_AUTHORIZED_POLICY "$policy_name"
    fi

    test -n "$FDE_AUTHORIZED_POLICY" || fde_bad_argument "FDE_AUTHORIZED_POLICY not set"
}

function add_secondary_key {

    local luks_devices="$1"
    local luks_new_keyfile="$2"

    luks_keyfile=$(fde_make_tempfile pass.key)
    if ! fde_request_recovery_passfile "$luks_keyfile"; then
	display_errorbox "Unable to obtain recovery password; aborting."
	return 1
    fi

    # Verify the recovery password on all specified LUKS partitions first
    for luks_dev in ${luks_devices}; do
	if ! luks_verify_password "$luks_dev" "$luks_keyfile"; then
	    rm -f "$luks_keyfile"
	    display_errorbox "Failed to verify password on LUKS partition (${luks_dev})"
	    return 1
	fi
    done

    luks_generate_random_key ${luks_new_keyfile}

    # Add the new random key to all specified LUKS partitions
    for luks_dev in ${luks_devices}; do
	if ! luks_add_key "${luks_dev}" "${luks_keyfile}" "${luks_new_keyfile}"; then
	    display_errorbox "Failed to add secondary LUKS key (${luks_dev})"
	    rm -f "$luks_keyfile"
	    return 1
	fi
    done

    rm -f "$luks_keyfile"
}

function enroll_tpm_secondary_key {

    local luks_devices="$1"

    if [[ "$FDE_USE_AUTHORIZED_POLICIES" =~ y.* ]]; then
	luks_new_keyfile="$(fde_make_tempfile newkey)"

	# add_secondary_key verifies the recovery password before it
	# changes anything, so the policy files are only touched after that
	if ! add_secondary_key "${luks_devices}" "${luks_new_keyfile}" ||
	   ! stage_authorized_policy; then
	    rm -rf "$luks_new_keyfile" "$FDE_AP_STAGE_DIR"
	    return 1
	fi

	if ! tpm_seal_secret "$luks_new_keyfile" \
		"$(_ap_staged "$FDE_AP_SEALED_SECRET")" \
		"$(_ap_staged "$FDE_AP_AUTHPOLICY")"; then
	    display_errorbox "Failed to seal secondary LUKS key against TPM Authorized Policy"
	    rm -rf "$luks_new_keyfile" "$FDE_AP_STAGE_DIR"
	    return 1
	fi
	rm -f "$luks_new_keyfile"

	if ! commit_authorized_policy; then
	    rm -rf "$FDE_AP_STAGE_DIR"
	    return 1
	fi
    else
	if [ -z "$opt_keyfile" ]; then
	    opt_keyfile="${FDE_CONFIG_DIR:-/etc/fde}/root.key"
	fi

	if ! add_secondary_key "$luks_devices" "$opt_keyfile"; then
	    return 1
	fi

	# Leave the keyfile around so that tpm-enable can seal it on the next reboot
	echo "Leaving secondary key in $opt_keyfile"
	fde_set_variable FDE_ENROLL_NEW_KEY "$opt_keyfile"
    fi
}
